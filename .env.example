# F7 — Capa de IA (TRD §9). Estas variables viven SOLO del lado del
# servidor (función serverless en api/), configuradas en el dashboard del
# hosting (Vercel: Project Settings -> Environment Variables) — NUNCA en
# este archivo con un valor real, y NUNCA leídas desde el bundle del
# cliente (Vite solo expone al cliente las variables prefijadas VITE_,
# así que basta con no usar ese prefijo para que esto sea inaccesible
# desde el navegador).

# Clave real de la API de Anthropic. El usuario final nunca la ve ni la aporta.
ANTHROPIC_API_KEY=

# Origen exacto de la PWA en producción, para restringir CORS del endpoint
# proxy a ese origen únicamente (no "*").
ALLOWED_ORIGIN=
